 @page "/questionentry"
@using System.ComponentModel.DataAnnotations
@using MauiApp1.Shared.Models
@using MauiApp1.Shared.Repositories
@inject NavigationManager navigationManager

<EditForm Model="@examModel" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label>Institute:</label>
        <InputText class="form-control" @bind-Value="examModel.Institute" />
    </div>

    <div class="form-group">
        <label>Program:</label>
        <InputText class="form-control" @bind-Value="examModel.Program" />
    </div>

    <div class="form-group">
        <label>Department:</label>
        <InputText class="form-control" @bind-Value="examModel.Department" />
    </div>

    <div class="form-group">
        <label>Subject:</label>
        <InputText class="form-control" @bind-Value="examModel.Subject" />
    </div>

    <div class="form-group">
        <label>Subject Code:</label>
        <InputText class="form-control" @bind-Value="examModel.SubjectCode" />
    </div>

    <div class="form-group">
        <label>Exam Name:</label>
        <InputText class="form-control" @bind-Value="examModel.ExamName" />
    </div>

    <div class="form-group">
        <label>Semester:</label>
        <InputText class="form-control" @bind-Value="examModel.Semester" />
    </div>

    <div class="form-group">
        <label>Year:</label>
        <InputNumber class="form-control" @bind-Value="examModel.Year" />
    </div>

    <div class="form-group">
        <label>Full Marks:</label>
        <InputText class="form-control" @bind-Value="examModel.FullMarks" />
    </div>

    <div class="form-group">
        <label>Duration:</label>
        <InputText class="form-control" @bind-Value="examModel.Duration" />
    </div>

    <h4>Section A</h4>
    <InputText class="form-control mb-2" placeholder="Section A Title" @bind-Value="examModel.SectionA" />
    <InputText class="form-control mb-2" placeholder="Question A1" @bind-Value="examModel.Question_A1" />
    <InputText class="form-control mb-2" placeholder="Question A2" @bind-Value="examModel.Question_A2" />
    <InputText class="form-control mb-2" placeholder="Question A3" @bind-Value="examModel.Question_A3" />
    <InputText class="form-control mb-2" placeholder="Question A4" @bind-Value="examModel.Question_A4" />
    <InputNumber class="form-control mb-2" placeholder="Marks A" @bind-Value="examModel.MarksA" />

    <h4>Section B</h4>
    <InputText class="form-control mb-2" placeholder="Section B Title" @bind-Value="examModel.SectionB" />
    <InputText class="form-control mb-2" placeholder="Question B1" @bind-Value="examModel.Question_B1" />
    <InputText class="form-control mb-2" placeholder="Question B2" @bind-Value="examModel.Question_B2" />
    <InputNumber class="form-control mb-2" placeholder="Marks B" @bind-Value="examModel.MarksB" />

    <h4>Section C</h4>
    <InputText class="form-control mb-2" placeholder="Section C Title" @bind-Value="examModel.SectionC" />
    <InputText class="form-control mb-2" placeholder="Question C1" @bind-Value="examModel.Question_C1" />
    <InputText class="form-control mb-2" placeholder="Question C2" @bind-Value="examModel.Question_C2" />
    <InputNumber class="form-control mb-2" placeholder="Marks C" @bind-Value="examModel.MarksC" />

    <div class="form-group">
        <label>Note:</label>
        <InputTextArea class="form-control" @bind-Value="examModel.Note" />
    </div>

    <button class="btn btn-primary mt-3" type="submit">Submit</button>
</EditForm>

@code {
    private QuestionPaper examModel = new();

    private void HandleValidSubmit()
    {
        // Handle the submission, e.g., send data to API or database
        QuestionRepo.Add(examModel);
        navigationManager.NavigateTo("/question");
        Console.WriteLine("Form submitted successfully!");
    }

}
