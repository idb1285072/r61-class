

@{
    ViewBag.Title = "Create";
}

<h2>Create</h2>
@Html.AntiForgeryToken()
<fieldset>
    <legend>Sales Order</legend>
    <table style="width:30%">
        <tr>
            <td>Order Number</td>
            <td>
                <input type="text" name="ordernumber" value="" placeholder="Order Number" id="txtOrdernumber" />
            </td>
            <td>Customer Name</td>
            <td>
                <input type="text" name="customername" value="" placeholder="CustomerName" id="txtcustomername" />
            </td>
            <td>Order Date</td>
            <td>
                <input type="date" name="Orderdate" value="" placeholder="Order date" id="Orderdate" />
            </td>
            <td>Status</td>
            <td>
                <input type="checkbox" name="ISCompleted" placeholder="Order date" id="ISCompleted" />
            </td>
            <td>
                <input type="file" name="ImageFile" value="" id="ImageFile" />
            </td>
        </tr>
    </table>
</fieldset>

<fieldset>
    <legend>Order Details</legend>
    <table id="tblOrderdetails">
        <thead>
            <tr>
                <th>ItemName</th>
                <th>Quantity</th>
                <th>UnitPrice</th>
                <th>Discount</th>
                <th>SubTotal</th>
                <th>Action</th>

            </tr>
        </thead>
        <tbody>
            <tr>
                <td>


                    @Html.DropDownList("ProductId", (IEnumerable<SelectListItem>)ViewBag.ProductId, "Select Product", new { @id = "ProductId" })
                </td>
                <td>
                    <input type="text" name="Quantity" onchange="CalculateSubTotal()" />
                </td>
                <td>
                    <input type="text" name="UnitPrice" onchange="CalculateSubTotal()" />
                </td>
                <td>
                    <input type="text" name="Discount" onchange="CalculateSubTotal()" />
                </td>
                <td>
                    <input type="text" name="SubTotal" readonly="readonly" />
                </td>
                <td>
                    <input type="button" value="Add" name="add" id="btnadd" onclick="AddSaleOrderRow()" />
                    <input type="button" value="Delete" name="delete" id="btndelete" onclick="DeleteSaleOrderRow(this)" />
                </td>
            </tr>
        </tbody>
        <tfoot>
            <tr>
                @*<td>
                    </td>
                    <td>
                    </td>
                    <td>
                    </td>*@
                <td colspan="3">
                    <b>Total</b>
                </td>
                <td>
                    <input type="text" name="Total" readonly="readonly" id="txtTotal" />
                </td>
                <td>
                </td>
            </tr>
            <tr>
                @*<td>
                    </td>
                    <td>
                    </td>
                    <td>
                    </td>
                    <td>
                    </td>*@
                <td colspan="6">
                    <input type="button" onclick="SaveOrderDetails()" name="Save order" value="save Order" />

                </td>
                @*<td>
                    </td>*@
            </tr>
        </tfoot>
    </table>
</fieldset>
@section scripts{
    <script type="text/javascript">
        var msg = ""
        $(document).ready(function () {
            $("#btndelete").hide();


        })
        function isValid() {
            isValiddata = true
          
            if ($("#txtOrdernumber").val() === "") {
                isValiddata = false;
                msg="provide order number"
            }
            return isValiddata;

        }
        function AddSaleOrderRow() {
            $("#btndelete").show();
            var tblbody = $("#tblOrderdetails").find("tbody")
            var tblLastRow = tblbody.find("tr:last")
            var tblClone = tblLastRow.clone().find("input[type=text]").val('').end();
            tblLastRow.after(tblClone);
            $("#btndelete").hide();

        }
        function DeleteSaleOrderRow() {
            $("#btndelete").closest("tr").remove();
            CalculateSubTotal();

        }
        function CalculateSubTotal() {

            var total = 0.00;
            var tblbody = $("#tblOrderdetails").find("tbody")
            tblbody.find('tr').each(function () {
                console.log($(this).find("td:eq(1) input[type=text]"))
                var quantity = $(this).find("td:eq(1) input[type=text]").val();
                var unitprice = $(this).find("td:eq(2) input[type=text]").val();
                var discount = $(this).find("td:eq(3) input[type=text]").val();
                var subtotal = (quantity * unitprice) - discount
                total = total + subtotal
                console.log("quantity" + quantity)
                console.log("unitprice" + unitprice)
                console.log(discount)
                console.log(total)
                console.log(subtotal)
                $(this).find("td:eq(4) input[type=text]").val(subtotal);
                $("#txtTotal").val(total);
            })
        }


        function SaveOrderDetails() {
            console.log(isValid())
            console.log(msg)
            if (isValid()) {
                var data = new FormData();
                SalesDetails = [];
                total = 0.00;
                var tblbody = $("#tblOrderdetails").find("tbody")
                tblbody.find('tr').each(function () {
                    var itemName = $(this).find("td:eq(0) select[name=ProductId]").val();
                    var quantity = $(this).find("td:eq(1) input[type=text]").val();
                    var unitprice = $(this).find("td:eq(2) input[type=text]").val();
                    var discount = $(this).find("td:eq(3) input[type=text]").val();
                    var subtotal = (quantity * unitprice) - discount

                    SalesDetails.push({
                        "ProductId": itemName, "Quantity": quantity, "UnitPrice": unitprice, "Discount": discount, "Total": subtotal
                    });

                })

                console.log($("#ISCompleted").prop("checked"))

                salesOrder = {
                    "Ordernumber": $("#txtOrdernumber").val(),
                    "Customername": $("#txtcustomername").val(),
                    "OrderDate": $("#Orderdate").val(),
                    "Total": $("#txtTotal").val(total),
                    "ISCompleted": $("#ISCompleted").prop("checked"),
                    "SalesDetails": SalesDetails,
                }
                var file = $('#ImageFile')[0].files[0];
                console.log(file)
                var reader = new FileReader();
                console.log(salesOrder)

                var formData = new FormData();
                var file = $('#ImageFile')[0].files[0];
                formData.append('file', file);
                formData.append('Ordernumber', $("#txtOrdernumber").val());
                $.ajax({
                    url: '/SalesDT/UploadFile',
                    type: 'POST',
                    data: formData,
                    contentType: false,
                    processData: false,
                    success: function (response) { // Handle success 
                        console.log(response)
                        salesOrder.Picture = response.FilePAth
                        save();
                        /* alert('File uploaded successfully!');*/

                    },
                    error: function (response) {
                        // Handle error 
                        console.log(response)
                        alert('File upload failed!');
                    }
                });

            }
            else {
                alert('provide Order number');
            }
                   
        }
        function save() {
            $.ajax({
                type: 'POST',

                dataType: 'JSON',
                url: '/SalesDT/Create',
                data: JSON.stringify(salesOrder),
                /*  data: salesOrder,*/
                contentType: 'application/json;charset=UTF-8',
                success: function (data) {
                    if (data.Success) {
                        alert(data.Message);
                       
                    }
                    else {
                        alert(data.Message);
                    }
                },
                error: function (error) {
                    alert("There is problem");
                    console.log(error)
                }
            });
        }

    </script>



}