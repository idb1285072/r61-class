@model  IEnumerable< person_core_mvc.Models.Address>

<form asp-action="Index" asp-controller="Persons"  method="post">
	<input type="text" name="FirstName" />
	<input type="submit" value="Search" />
	
	<table class="table table-bordered">
		<thead>
			<tr>
				<td>
					AddressLine1
				</td>
				<td>
					AddressLine1
				</td>
				<td>
					City
				</td>
			</tr>
		</thead>
		<tbody>
			@if (Model.Count() > 0)
			{
			@foreach(var item in Model)
			{
				<tr>
					<td>
						@item.AddressLine1
					</td>
					<td>
						@item.AddressLine2
					</td>
					<td>
						@item.City
					</td>
				</tr>
			}
			}
			else
			{
			<tr>
				<td colspan="3">
					No record found
				</td>
				 
			</tr>

			}


		</tbody>
	</table>
	
</form>