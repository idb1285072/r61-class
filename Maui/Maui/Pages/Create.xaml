<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.Pages.Create"
             Title="Create">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Edit Student" FontSize="24" FontAttributes="Bold" />

            <Entry x:Name="NameEntry" Placeholder="Student Name" />

            <DatePicker x:Name="AdmissionDatePicker"
                        Format="yyyy-MM-dd"
                        MinimumDate="2000-01-01"
                        xmlns:sys="clr-namespace:System;assembly=netstandard" />

            <StackLayout Orientation="Horizontal" Spacing="10">
                <Label Text="Is Active" VerticalOptions="Center"/>
                <Switch x:Name="IsActiveSwitch" />
            </StackLayout>

            <Button Text="Save" Clicked="OnSaveClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>