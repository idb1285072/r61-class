          },
          "order": {
            "$ref": "#/components/schemas/Order"
          }
        },
        "additionalProperties": false
      },
      "Order": {
        "required": [
          "customerName",
          "orderDate",
          "picture"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "customerName": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "orderDate": {
            "type": "string",
            "format": "date"
          },
          "picture": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "isDelivered": {
            "type": "boolean"
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Detail"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Product": {
        "required": [
